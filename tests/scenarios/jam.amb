# The JAM page (the SELECT dial, after Global and the Set list): the keys are an instrument and never edit the scale. Voice (K1): pluck, pad, acid, drone; Keys (K2): scale, chords,
# harp; Octave (K3); Sound (K4): the sound of that voice (0.17.4; it was Answer).
seed 0
wait 3000
tap GLO
expect view 32
spin SELECT 1
wait 100
spin SELECT 1
wait 100
expect view 34
expect jamv 0
shot jam_pluck.png
# the pad, scale keys: one key, one note held; the scale untouched
spin K1 1
wait 50
expect jamv 1
key 13 down
wait 200
expect held 1
expect pool 0x5AD
shot jam_held.png
key 13 up
wait 100
expect held 0
# chords: three notes
spin K2 1
wait 50
expect jamm 1
key 13 down
wait 200
expect held 3
key 13 up
wait 100
expect held 0
# the harp
spin K2 1
wait 50
expect jamm 2
key 0 down
wait 200
expect held 1
key 0 up
wait 100
expect pool 0x5AD
# Sound (K4, 0.17.4, for Answer): the sound of the voice the page plays; the pluck's, then the pad's
spin K2 -2
spin K1 -1
wait 50
expect jamv 0
expect par99 1
spin K4 1
wait 100
expect par99 2
spin K1 1
wait 50
expect jamv 1
expect par10 1
spin K4 1
wait 100
expect par10 2
expect par99 2